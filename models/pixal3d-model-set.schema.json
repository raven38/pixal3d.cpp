{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raven38/pixal3d.cpp/models/pixal3d-model-set.schema.json",
  "title": "Pixal3D model set manifest",
  "description": "Schema v1 describes the full textured production model set. Duplicate names/roles and required-role completeness are semantic constraints enforced by consumers because JSON Schema cannot express name uniqueness across an array.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_set", "version", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "model_set": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "required", "size_bytes", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^(?!\\.\\.?$)[^/\\\\]+$" },
          "role": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
