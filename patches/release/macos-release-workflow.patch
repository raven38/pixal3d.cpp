+          - { os: macos,   backend: metal,  runner: macos-14 }
 
     steps:
       - uses: actions/checkout@v4
@@ -216,6 +219,30 @@ jobs:
             fi
             ASSET="trellis-${{ matrix.release_backend || matrix.backend }}-windows-x64.zip"
             (cd dist && 7z a -y "../$ASSET" ./* >/dev/null)
+          elif [ "${{ matrix.os }}" = "macos" ]; then
+            cp build/trellis-server dist/
+            cp build/trellis-cli dist/
+            # Measured on a local Metal build: the binaries reference
+            # @rpath/libggml{,-base,-cpu,-blas,-metal}.0.dylib and no separate
+            # .metallib is produced (the Metal shaders are embedded), so ship the
+            # dylibs and let an @loader_path rpath resolve them.
+            find build -name 'libggml*.dylib' -exec cp -P {} dist/ \;
+            # CMake already bakes @loader_path (verified locally: the tarball runs
+            # with the build-dir rpath removed), but it also bakes the absolute
+            # build directory. Strip that so a released binary carries no path
+            # from the build machine; add @loader_path only if it is missing.
+            for f in dist/trellis-server dist/trellis-cli; do
+              build_abs="$(cd build && pwd)"
+              install_name_tool -delete_rpath "$build_abs" "$f" 2>/dev/null || true
+              otool -l "$f" | grep -q 'path @loader_path' \
+                || install_name_tool -add_rpath @loader_path "$f"
+            done
+            # Fail loudly if the result is not self-contained.
+            for f in dist/trellis-server dist/trellis-cli; do
+              otool -l "$f" | grep -q 'path @loader_path' || { echo "ERROR: $f has no @loader_path rpath"; exit 1; }
+            done
+            ASSET="trellis-${{ matrix.backend }}-macos-arm64.tar.gz"
+            tar -C dist -czf "$ASSET" .
           else
             cp build/trellis-server dist/
             cp build/trellis-cli dist/
