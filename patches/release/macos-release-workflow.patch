           - { os: windows, backend: cuda,   release_backend: cuda,   cuda_version: "13.1.0", cuda_archs: "75;80;86;89;90;120", runner: windows-2022, experimental: true }
           - { os: windows, backend: cuda,   release_backend: cuda12, cuda_version: "12.9.1", cuda_archs: "60;61;70",          runner: windows-2022, experimental: true }
           - { os: windows, backend: rocm,   runner: windows-2022, experimental: true }
+          # macOS/Apple Silicon: Metal is enabled by CMake automatically
