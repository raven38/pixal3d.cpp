+bool ggml_backend_cuda_mmq_prepack_q8_1(
+        ggml_backend_t backend, const ggml_tensor * src_f32,
+        ggml_tensor * dst_q8_1, enum ggml_type weight_type) {
+    if (!backend || !ggml_backend_is_cuda(backend) || !src_f32 || !dst_q8_1) {
+        return false;
+    }
+    if (src_f32->type != GGML_TYPE_F32 || dst_q8_1->type != GGML_TYPE_Q8_1 ||
+        weight_type != GGML_TYPE_Q8_0 || !ggml_is_contiguous(src_f32) ||
+        !ggml_is_contiguous(dst_q8_1)) {
+        return false;
+    }
+    for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+        if (src_f32->ne[i] != dst_q8_1->ne[i]) {
+            return false;
+        }
+    }
+    // quantize_mmq_q8_1_cuda pads ne0 to MATRIX_ROW_PADDING. The public Q8_1
+    // tensor owns only its logical bytes, so only use the cache when no padding
+    // is needed (Pixal3D proj_in is 1024 or 2048).
+    if (src_f32->ne[0] % MATRIX_ROW_PADDING != 0) {
+        return false;
+    }
+
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    quantize_mmq_q8_1_cuda(
+        (const float *) src_f32->data, nullptr, dst_q8_1->data, weight_type,
+        src_f32->ne[0],
+        src_f32->nb[1] / sizeof(float),
+        src_f32->nb[2] / sizeof(float),
+        src_f32->nb[3] / sizeof(float),
+        src_f32->ne[0], src_f32->ne[1], src_f32->ne[2], src_f32->ne[3],
+        ctx->stream());
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
