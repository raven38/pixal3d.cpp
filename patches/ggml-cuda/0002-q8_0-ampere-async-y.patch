+template <int n_ints>
+static __device__ __forceinline__ void mmq_cp_async_q8_y(int * __restrict__ dst, const int * __restrict__ src) {
+#if defined(PIXAL3D_CUDA_Q8_ASYNC_Y) && defined(AMPERE_MMA_AVAILABLE)
+    constexpr int ints_per_copy = 4; // cp.async 16 B
+    constexpr int nthreads = mmq_get_nwarps_device() * ggml_cuda_get_physical_warp_size();
+    const int tid = threadIdx.y * ggml_cuda_get_physical_warp_size() + threadIdx.x;
+#pragma unroll
+    for (int i = ints_per_copy * tid; i < n_ints; i += ints_per_copy * nthreads) {
+        const unsigned smem = __cvta_generic_to_shared(dst + i);
+        asm volatile("cp.async.cg.shared.global [%0], [%1], 16;\n" :: "r"(smem), "l"(src + i));
+    }
+#else
+    GGML_UNUSED_VARS(dst, src);
+#endif
+}
+
+static __device__ __forceinline__ void mmq_cp_async_commit() {
+#if defined(PIXAL3D_CUDA_Q8_ASYNC_Y) && defined(AMPERE_MMA_AVAILABLE)
+    asm volatile("cp.async.commit_group;\n" ::);
+#endif
+}
+
+static __device__ __forceinline__ void mmq_cp_async_wait_all() {
+#if defined(PIXAL3D_CUDA_Q8_ASYNC_Y) && defined(AMPERE_MMA_AVAILABLE)
+    asm volatile("cp.async.wait_group 0;\n" ::);
+#endif
+}
