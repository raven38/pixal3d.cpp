# build artifacts
/build/
/build-vk/
/build-*/
*.o
*.a
*.so

# models & weights live on D_SSD, never in the repo
*.gguf
*.safetensors
*.bin
/models/*
!/models/.gitkeep
# release model-set manifests are contracts, not weights: keep them tracked
!/models/pixal3d-model-set.schema.json
!/models/*/
/models/*/*
!/models/*/pixal3d-models.json

# python / venv
__pycache__/
*.pyc
.venv/

# editor / tooling caches
/.cache/

# scratch
/out/
*.glb
!assets/showcase/*/*.glb
*.tmp
dumps/

# browser tooling
web/node_modules/

# WASM smoke build artifacts
web/smoke/pixal3d_smoke.js
web/smoke/pixal3d_smoke.wasm
web/ops/pixal3d_ops.js
web/ops/pixal3d_ops.wasm
build-wasm/
build-webgpu/

# WASM stage / E2E build artifacts
web/ss/pixal3d_ss.js
web/ss/pixal3d_ss.wasm
web/texture/pixal3d_texture.js
web/texture/pixal3d_texture.wasm
web/partial_e2e/pixal3d_partial_e2e.js
web/partial_e2e/pixal3d_partial_e2e.wasm
web/full_e2e/pixal3d_full_e2e.js
web/full_e2e/pixal3d_full_e2e.wasm
web/real_e2e/pixal3d_real_geometry.js
web/real_e2e/pixal3d_real_geometry.wasm
build-wasm-ss/

